# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointment_system

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=change_this_cookie_secret

# Redis (caching, distributed locks, idempotency, BullMQ background jobs)
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth (passport-google-oauth20)
# Leave blank to disable - /api/auth/google routes will respond 501 until set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Two-factor authentication (speakeasy) - challenge token signing secret.
# Falls back to JWT_ACCESS_SECRET if not set, but a dedicated secret is safer.
JWT_2FA_SECRET=change_this_2fa_challenge_secret

# Logging (winston)
LOG_LEVEL=debug

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="City Care Hospital <no-reply@citycarehospital.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@citycarehospital.com
ADMIN_PASSWORD=Admin@12345
